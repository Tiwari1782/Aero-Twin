# PostgreSQL connection
DATABASE_URL=postgresql://aerotwin_user:YOUR_PASSWORD@localhost:5432/aerotwin_db

# Flask config
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here

# Simulation settings
SIMULATION_SPEED_SECONDS=2
SIMULATION_MAX_HOURS=1000
DEFAULT_MODE=live

# C-MAPSS dataset path (relative to project root)
CMAPSS_CSV_PATH=Data/train_FD001.csv

# ML model path
MODEL_PATH=ml/aerotwin_model.pkl
